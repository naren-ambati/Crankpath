    "exit-codes": {
      "lane": "offline",
      "what": "every exit code: 0 for a run that analysed (a cycle is not an error), 1 for an input or usage error, 2 for NOTHING ANALYSED",
      "runs": [
        {
          "name": "exit-0",
          "args": [
            "examples/thin-slice/repo",
            "--repo-url",
            "http://gitea-http.gitea:3000/ops/thin-slice"
          ],
          "exit": 0,
          "stdout": {
            "lines": [
              "Run status: ANALYSED",
              "Cycles: 1 uncranked"
