          "exit": 1,
          "stdout": {
            "empty": true
          },
          "stderr": {
            "lines": [
              "error: invalid crankpath.yaml at key path \"cranks[0].reroute\" (unknown key)"
            ]
          }
        },
        {
          "name": "exit-1-usage",
          "args": [
            "examples/thin-slice/repo",
            "--repo-url",
            "http://gitea-http.gitea:3000/ops/thin-slice",
            "--format",
            "yaml"
          ],
          "exit": 1,
          "stdout": {
            "empty": true
          },
          "stderr": {
            "lines": [
              "error: unknown format \"yaml\" (text, json or mermaid)"
