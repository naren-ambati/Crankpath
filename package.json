{
  "name": "crankpath",
  "version": "0.1.0",
  "description": "A black-start planner and cycle finder for GitOps estates: reads a GitOps repository, renders Helm and Kustomize, and reports dependency cycles, cold-start reachability and an ordered restoration plan.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naren-ambati/crankpath.git"
  },
  "homepage": "https://github.com/naren-ambati/crankpath#readme",
  "bugs": {
    "url": "https://github.com/naren-ambati/crankpath/issues"
  },
  "type": "module",
  "bin": {
    "crankpath": "dist/u9-cli-package/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/u9-cli-package/library.d.ts",
      "default": "./dist/u9-cli-package/library.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "check-tree": "node scripts/check-tree.mjs",
    "census": "node scripts/census.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build && vitest run --coverage && node scripts/release-checks.mjs",
    "release:check": "npm run build && node scripts/release-checks.mjs --release",
    "docs:check": "node scripts/check-docs.mjs",
    "examples": "node scripts/examples.mjs",
    "images:check": "node scripts/check-images.mjs",
    "secret-grep": "node scripts/secret-grep.mjs",
    "pack:check": "node scripts/check-pack.mjs",
    "verify:live": "npm run build && node scripts/live-render.mjs && node scripts/live-fetch.mjs",
    "verify:golden": "npm run build && node scripts/golden.mjs"
  },
  "dependencies": {
    "commander": "15.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
