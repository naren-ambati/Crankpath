{
  "case": "vault",
  "description": "The Vault fixture before its two documented edits (US11.3, AC11.3.1), rendered with real helm: cycle A, cycle B, three externals with unspecified cold start, nothing else uncranked. The two public charts are git sources on github.com, fetched read-only into the golden cache and read through --repo-alias; the private platform repository is the fixture's platform/ tree.",
  "form": "full",
  "needs": ["helm", "kustomize", "git", "network"],
  "tools": {
    "helm": "v4.3.2",
    "kustomize": "v5.8.1"
  },
  "input": {
    "fixture": "test/fixtures/vault",
    "parts": ["gitops", "platform"],
    "scan": "gitops"
  },
  "fetch": [
    {
      "id": "vault-helm",
      "url": "https://github.com/hashicorp/vault-helm",
      "rev": "v0.34.1",
      "sha": "aa1c92e4adddbce9660e536dfe5222a88eda6d52"
    },
    {
      "id": "external-secrets",
      "url": "https://github.com/external-secrets/external-secrets",
      "rev": "helm-chart-2.9.0",
      "sha": "cc5bfbc2234ace9cb0caff4ea89c435cf517b27b",
      "sparse": ["deploy/charts/external-secrets"]
    }
  ],
  "args": [
    "--repo-url",
    "https://github.com/acme/platform-gitops",
    "--repo-alias",
    "git@github.com:acme/platform.git={tree}/platform",
    "--repo-alias",
    "https://github.com/hashicorp/vault-helm={src:vault-helm}",
    "--repo-alias",
    "https://github.com/external-secrets/external-secrets={src:external-secrets}"
  ],
  "mutations": [
    {
      "id": "drop-platform-alias",
      "kind": "drop an alias",
      "why": "without the platform repository, the platform Application and the $values of the vault and external-secrets Applications are unreadable: both cycles go and three sources are opaque",
      "edits": [
        {
          "op": "drop-arg",
          "flag": "--repo-alias",
          "startsWith": "git@github.com:acme/platform.git="
        }
      ],
      "expect": {
        "cycles": 0,
        "opaque": 3,
        "cycleIds": [],
        "opaqueNodes": [
          "Application/argocd/external-secrets",
          "Application/argocd/platform",
          "Application/argocd/vault"
        ]
      }
    },
    {
      "id": "remove-credential-label",
      "kind": "remove an edge source",
      "why": "an ExternalSecret whose Secret carries no Argo CD secret-type label makes no repository credential: the needs-credential edge goes and cycle A with it",
      "edits": [
        {
          "op": "replace",
          "path": "platform/manifests/argocd/repo-platform.yaml",
          "from": "argocd.argoproj.io/secret-type: repository",
          "to": "example.org/purpose: repository"
        }
      ],
      "expect": {
        "cycles": 1,
        "uncranked": 1,
        "cycleIds": ["c-ba4047ac"],
        "opaqueNodes": [],
        "labels": ["extracted"]
      }
    },
    {
      "id": "rename-vault-service",
      "kind": "rename a node",
      "why": "with fullnameOverride the chart names Vault's Service vault-main: the ClusterIssuer's server host vault.vault.svc matches no Service, and cycle B goes",
      "edits": [
        {
          "op": "replace",
          "path": "platform/values/vault.yaml",
          "from": "injector:\n  enabled: false\n",
          "to": "fullnameOverride: vault-main\ninjector:\n  enabled: false\n"
        }
      ],
      "expect": {
        "cycles": 1,
        "uncranked": 1,
        "cycleIds": ["c-35505771"],
        "opaqueNodes": [],
        "labels": ["extracted"]
      }
    }
  ]
}
